# Transcription with word timestamps (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Voice cloning + lip sync (https://magichour.ai/developer?tab=api-keys)
MAGIC_HOUR_API_KEY=

# Optional: powers the "Clean up" button (https://console.anthropic.com).
# Without it, Clean up falls back to a basic um/uh/repeat scan.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Password-protect the whole site (any username works). Set this on any public deploy.
# SITE_PASSWORD=

# Optional overrides
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# RETAKE_DATA_DIR=./.retake-data
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
