# The two keys Retake runs on. See SETUP.md.
# Transcripts (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Voice cloning and lip sync (https://magichour.ai/developer?tab=api-keys)
MAGIC_HOUR_API_KEY=

# Where projects are stored. On Railway, a volume mounted at /data.
# RETAKE_DATA_DIR=/data

# Daily caps on Magic Hour spend (reset at midnight UTC). 30 credits = 1 second of lip sync.
# Use "unlimited" to remove a cap.
# MAGIC_HOUR_DAILY_CREDITS=3000
# MAGIC_HOUR_VISITOR_DAILY_CREDITS=400

# Password-protect the whole site (any username works).
# SITE_PASSWORD=

# Analytics: an Umami Cloud website id turns on visit and event tracking.
# UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Optional
# ANTHROPIC_API_KEY=           # Clean up with Claude instead of a basic um/uh scan
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# MAX_UPLOAD_MB=500
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
