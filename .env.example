# Voice cloning + lip sync for every visitor, billed to you (https://magichour.ai/developer?tab=api-keys)
MAGIC_HOUR_API_KEY=

# Daily caps on what visitors can spend from your Magic Hour balance (resets at midnight UTC).
# 30 credits = 1 second of lip sync. Use "unlimited" to remove a cap.
# MAGIC_HOUR_DAILY_CREDITS=3000
# MAGIC_HOUR_VISITOR_DAILY_CREDITS=400

# Visitors enter their own OpenAI and Anthropic keys in the app (Keys, top right).
# These are local-testing fallbacks only. Leave them unset on a public deploy,
# or every visitor's transcripts and Clean up get billed to you.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Password-protect the whole site (any username works).
# SITE_PASSWORD=

# Optional overrides
# MAX_UPLOAD_MB=500
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# RETAKE_DATA_DIR=./.retake-data
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Analytics (optional): an Umami Cloud website id turns on visit and event tracking.
# See SETUP.md section 6.
# UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
